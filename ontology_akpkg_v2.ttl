# ── Collaborations (symmetric — reasoner infers both directions) ─────────────
akp:author_vaswani   akp:collaboratesWith akp:author_devlin .
akp:author_lecun     akp:collaboratesWith akp:author_bengio .
akp:author_bengio    akp:collaboratesWith akp:author_hinton .
akp:author_goodfellow akp:collaboratesWith akp:author_bengio .

# ── Publications ─────────────────────────────────────────────────────────────

akp:paper_attention rdf:type akp:ConferencePaper ;
    akp:title         "Attention Is All You Need" ;
    akp:year          2017 ;
    akp:doi           "10.48550/arXiv.1706.03762" ;
    akp:abstract      "We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely." ;
    akp:citationCount 90000 ;
    akp:hasAuthor     akp:author_vaswani ;
    akp:publishedIn   akp:conf_neurips ;
    akp:hasKeyword    akp:kw_transformer ;
    akp:hasKeyword    akp:kw_attention ;
    akp:belongsToField akp:field_nlp .

akp:paper_bert rdf:type akp:ConferencePaper ;
    akp:title         "BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding" ;
    akp:year          2019 ;
    akp:doi           "10.48550/arXiv.1810.04805" ;
    akp:abstract      "We introduce BERT, a new language representation model designed to pre-train deep bidirectional representations from unlabeled text." ;
    akp:citationCount 55000 ;
    akp:hasAuthor     akp:author_devlin ;
    akp:publishedIn   akp:conf_acl ;
    akp:hasKeyword    akp:kw_bert ;
    akp:hasKeyword    akp:kw_transformer ;
    akp:belongsToField akp:field_nlp ;
    akp:cites         akp:paper_attention .

akp:paper_gcn rdf:type akp:ConferencePaper ;
    akp:title         "Semi-Supervised Classification with Graph Convolutional Networks" ;
    akp:year          2017 ;
    akp:doi           "10.48550/arXiv.1609.02907" ;
    akp:abstract      "We present a scalable approach for semi-supervised classification of nodes in a graph using an efficient variant of convolutional neural networks." ;
    akp:citationCount 25000 ;
    akp:hasAuthor     akp:author_kipf ;
    akp:publishedIn   akp:conf_iclr ;
    akp:hasKeyword    akp:kw_gnn ;
    akp:belongsToField akp:field_ml .

akp:paper_word2vec rdf:type akp:ConferencePaper ;
    akp:title         "Distributed Representations of Words and Phrases and their Compositionality" ;
    akp:year          2013 ;
    akp:doi           "10.48550/arXiv.1310.4546" ;
    akp:abstract      "We present several extensions of the original word2vec model including techniques for learning representations of phrases." ;
    akp:citationCount 18000 ;
    akp:hasAuthor     akp:author_mikolov ;
    akp:publishedIn   akp:conf_neurips ;
    akp:hasKeyword    akp:kw_llm ;
    akp:belongsToField akp:field_nlp .

akp:paper_gans rdf:type akp:ConferencePaper ;
    akp:title         "Generative Adversarial Networks" ;
    akp:year          2014 ;
    akp:doi           "10.48550/arXiv.1406.2661" ;
    akp:abstract      "We propose a new framework for estimating generative models via an adversarial process in which two models are simultaneously trained." ;
    akp:citationCount 40000 ;
    akp:hasAuthor     akp:author_goodfellow ;
    akp:hasAuthor     akp:author_bengio ;
    akp:publishedIn   akp:conf_neurips ;
    akp:hasKeyword    akp:kw_rl ;
    akp:belongsToField akp:field_ml .

akp:paper_deeplearning rdf:type akp:JournalArticle ;
    akp:title         "Deep Learning" ;
    akp:year          2015 ;
    akp:doi           "10.1038/nature14539" ;
    akp:abstract      "Deep learning allows computational models composed of multiple processing layers to learn representations of data with multiple levels of abstraction." ;
    akp:citationCount 65000 ;
    akp:hasAuthor     akp:author_lecun ;
    akp:hasAuthor     akp:author_bengio ;
    akp:hasAuthor     akp:author_hinton ;
    akp:publishedIn   akp:journal_nature ;
    akp:hasKeyword    akp:kw_llm ;
    akp:belongsToField akp:field_ml .

akp:paper_kg_embed rdf:type akp:JournalArticle ;
    akp:title         "Knowledge Graph Embedding: A Survey of Approaches and Applications" ;
    akp:year          2017 ;
    akp:doi           "10.1109/TKDE.2017.2754499" ;
    akp:abstract      "This paper reviews knowledge graph embedding methods, which project entities and relations into continuous vector spaces for downstream tasks." ;
    akp:citationCount 5000 ;
    akp:hasAuthor     akp:author_hinton ;
    akp:publishedIn   akp:journal_jair ;
    akp:hasKeyword    akp:kw_ontology ;
    akp:hasKeyword    akp:kw_sparql ;
    akp:belongsToField akp:field_kg ;
    akp:cites         akp:paper_gcn .

akp:paper_llm_survey rdf:type akp:JournalArticle ;
    akp:title         "A Survey of Large Language Models" ;
    akp:year          2023 ;
    akp:doi           "10.48550/arXiv.2303.18223" ;
    akp:abstract      "This paper reviews the recent advances of large language models, including pre-training, instruction tuning, alignment, and evaluation." ;
    akp:citationCount 8000 ;
    akp:hasAuthor     akp:author_bengio ;
    akp:publishedIn   akp:journal_jair ;
    akp:hasKeyword    akp:kw_llm ;
    akp:hasKeyword    akp:kw_transformer ;
    akp:belongsToField akp:field_nlp ;
    akp:cites         akp:paper_attention ;
    akp:cites         akp:paper_bert .       # [v2] new citation edge
