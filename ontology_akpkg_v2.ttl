@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix akp:     <http://www.akpkg.org/ontology#> .

# ═══════════════════════════════════════════════════════════════════════════════
# Ontology Declaration — Version 2.0
# Changes from v1.0:
#   - versionInfo updated to 2.0
#   - foaf:Person alignment added to akp:Author (owl:equivalentClass)
#   - skos:Concept alignment added to akp:Keyword
#   - rdfs:comment annotations added to ALL object properties (Widoco support)
#   - akp:abstract data property added to akp:Publication
#   - collaboratesWith formally declared owl:SymmetricProperty (was already, now explicit)
#   - ABox: 2 new citation edges added (paper_llm_survey → paper_bert, paper_attention)
#   - ABox: abstract literals filled in for all 8 papers
# ═══════════════════════════════════════════════════════════════════════════════

<http://www.akpkg.org/ontology>
    rdf:type owl:Ontology ;
    rdfs:label "Academic Publication Knowledge Graph Ontology" ;
    rdfs:comment "An OWL 2 DL ontology for modeling academic publications, authors, citation networks, research institutions, research fields, and keywords. Developed as part of the Knowledge Engineering and Ontologies course project (Topic 7)." ;
    owl:versionInfo "2.0" ;
    dcterms:created "2026-04-25" ;
    dcterms:modified "2026-05-09" ;
    dcterms:creator "Academic KG Project Team" .

# ═══════════════════════════════════════════════════════════════════════════════
# TBox — Classes
# ═══════════════════════════════════════════════════════════════════════════════

akp:Publication rdf:type owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "An academic publication of any type (journal article, conference paper, etc.)." .

akp:Paper rdf:type owl:Class ;
    rdfs:subClassOf akp:Publication ;
    rdfs:label "Paper" ;
    rdfs:comment "A standalone research paper that can be published in a journal or presented at a conference." .

akp:JournalArticle rdf:type owl:Class ;
    rdfs:subClassOf akp:Paper ;
    rdfs:label "Journal Article" ;
    rdfs:comment "A peer-reviewed paper published in an academic journal." .

akp:ConferencePaper rdf:type owl:Class ;
    rdfs:subClassOf akp:Paper ;
    rdfs:label "Conference Paper" ;
    rdfs:comment "A paper presented and published in the proceedings of an academic conference or workshop." .

# [v2] Author aligned with foaf:Person for interoperability
akp:Author rdf:type owl:Class ;
    rdfs:label "Author" ;
    rdfs:comment "A researcher or scholar who has authored one or more academic publications." ;
    owl:equivalentClass foaf:Person .

akp:Institution rdf:type owl:Class ;
    rdfs:label "Institution" ;
    rdfs:comment "A university, research laboratory, or other organization with which an author is affiliated." .

akp:Venue rdf:type owl:Class ;
    rdfs:label "Venue" ;
    rdfs:comment "An abstract publication outlet. Specialized into Journal and Conference." .

akp:Journal rdf:type owl:Class ;
    rdfs:subClassOf akp:Venue ;
    rdfs:label "Journal" ;
    rdfs:comment "A peer-reviewed periodic academic publication with an associated impact factor." .

akp:Conference rdf:type owl:Class ;
    rdfs:subClassOf akp:Venue ;
    rdfs:label "Conference" ;
    rdfs:comment "An academic conference or workshop at which research papers are presented." .

akp:ResearchField rdf:type owl:Class ;
    rdfs:label "Research Field" ;
    rdfs:comment "A broad scientific or engineering research domain (e.g., Machine Learning, NLP)." .

# [v2] Keyword aligned with skos:Concept for future taxonomy support
akp:Keyword rdf:type owl:Class ;
    rdfs:label "Keyword" ;
    rdfs:comment "A thematic descriptor assigned to a publication. Aligned with skos:Concept to support future hierarchical keyword taxonomies." ;
    owl:equivalentClass skos:Concept .

# ═══════════════════════════════════════════════════════════════════════════════
# TBox — Object Properties
# [v2] rdfs:comment added to ALL object properties for Widoco documentation
# ═══════════════════════════════════════════════════════════════════════════════

akp:hasAuthor rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  akp:Author ;
    rdfs:label  "has author" ;
    rdfs:comment "Links a publication to one or more of its authors." .

akp:affiliatedWith rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Author ;
    rdfs:range  akp:Institution ;
    rdfs:label  "affiliated with" ;
    rdfs:comment "Indicates the institution or organization with which an author is affiliated at the time of publication." .

akp:publishedIn rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  akp:Venue ;
    rdfs:label  "published in" ;
    rdfs:comment "Specifies the venue (journal or conference) in which a publication appeared." .

akp:cites rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  akp:Publication ;
    rdfs:label  "cites" ;
    rdfs:comment "Represents a direct citation relationship: the subject publication references the object publication in its bibliography." .

akp:hasKeyword rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  akp:Keyword ;
    rdfs:label  "has keyword" ;
    rdfs:comment "Associates a publication with one or more thematic keywords that describe its content." .

akp:belongsToField rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  akp:ResearchField ;
    rdfs:label  "belongs to field" ;
    rdfs:comment "Indicates the broad research domain to which a publication belongs." .

# [v2] owl:SymmetricProperty explicitly declared (infers both directions)
akp:collaboratesWith rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain akp:Author ;
    rdfs:range  akp:Author ;
    rdfs:label  "collaborates with" ;
    rdfs:comment "A symmetric property indicating that two authors have co-authored at least one publication together. If A collaboratesWith B, the reasoner infers B collaboratesWith A." .

# ═══════════════════════════════════════════════════════════════════════════════
# TBox — Data Properties
# ═══════════════════════════════════════════════════════════════════════════════

akp:title rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  xsd:string ;
    rdfs:label  "title" ;
    rdfs:comment "The full title of the publication." .

akp:year rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  xsd:integer ;
    rdfs:label  "year" ;
    rdfs:comment "The calendar year in which the publication was published." .

akp:doi rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  xsd:string ;
    rdfs:label  "DOI" ;
    rdfs:comment "The Digital Object Identifier of the publication, following the format 10.XXXX/suffix." .

# [v2] abstract was already in v1 ABox — now formally declared with comment
akp:abstract rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  xsd:string ;
    rdfs:label  "abstract" ;
    rdfs:comment "The abstract text of the publication. Used for keyword extraction and semantic search pipelines." .

akp:citationCount rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range  xsd:integer ;
    rdfs:label  "citation count" ;
    rdfs:comment "The number of times this publication has been cited by other works, as recorded on Semantic Scholar (snapshot: 2024-01-01)." .

akp:name rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Author ;
    rdfs:range  xsd:string ;
    rdfs:label  "name" ;
    rdfs:comment "The full canonical name of the author (e.g., 'Yann LeCun')." .

akp:orcid rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Author ;
    rdfs:range  xsd:string ;
    rdfs:label  "ORCID" ;
    rdfs:comment "The ORCID identifier of the author in the format XXXX-XXXX-XXXX-XXXX." .

akp:hIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Author ;
    rdfs:range  xsd:integer ;
    rdfs:label  "h-index" ;
    rdfs:comment "The h-index of the author, a bibliometric measure of research productivity and impact." .

akp:institutionName rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Institution ;
    rdfs:range  xsd:string ;
    rdfs:label  "institution name" ;
    rdfs:comment "The full official name of the institution." .

akp:country rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Institution ;
    rdfs:range  xsd:string ;
    rdfs:label  "country" ;
    rdfs:comment "The country in which the institution is located." .

akp:venueName rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Venue ;
    rdfs:range  xsd:string ;
    rdfs:label  "venue name" ;
    rdfs:comment "The full name of the publication venue (journal or conference)." .

akp:impactFactor rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Journal ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "impact factor" ;
    rdfs:comment "The Journal Impact Factor (JIF), a metric reflecting the yearly average number of citations for articles published in the journal." .

# ═══════════════════════════════════════════════════════════════════════════════
# ABox — Instances
# ═══════════════════════════════════════════════════════════════════════════════

# ── Institutions ─────────────────────────────────────────────────────────────
akp:inst_mit rdf:type akp:Institution ;
    akp:institutionName "Massachusetts Institute of Technology" ;
    akp:country "USA" .

akp:inst_stanford rdf:type akp:Institution ;
    akp:institutionName "Stanford University" ;
    akp:country "USA" .

akp:inst_cambridge rdf:type akp:Institution ;
    akp:institutionName "University of Cambridge" ;
    akp:country "UK" .

akp:inst_metu rdf:type akp:Institution ;
    akp:institutionName "Middle East Technical University" ;
    akp:country "Turkey" .

# ── Research Fields ──────────────────────────────────────────────────────────
akp:field_ml rdf:type akp:ResearchField ;
    rdfs:label "Machine Learning" .

akp:field_nlp rdf:type akp:ResearchField ;
    rdfs:label "Natural Language Processing" .

akp:field_kg rdf:type akp:ResearchField ;
    rdfs:label "Knowledge Graphs" .

akp:field_cv rdf:type akp:ResearchField ;
    rdfs:label "Computer Vision" .

# ── Journals ─────────────────────────────────────────────────────────────────
akp:journal_nature rdf:type akp:Journal ;
    akp:venueName "Nature" ;
    akp:impactFactor 49.962 .

akp:journal_science rdf:type akp:Journal ;
    akp:venueName "Science" ;
    akp:impactFactor 47.728 .

akp:journal_jair rdf:type akp:Journal ;
    akp:venueName "Journal of Artificial Intelligence Research" ;
    akp:impactFactor 4.676 .

# ── Conferences ──────────────────────────────────────────────────────────────
akp:conf_neurips rdf:type akp:Conference ;
    akp:venueName "NeurIPS" .

akp:conf_iclr rdf:type akp:Conference ;
    akp:venueName "ICLR" .

akp:conf_acl rdf:type akp:Conference ;
    akp:venueName "ACL" .

akp:conf_aaai rdf:type akp:Conference ;
    akp:venueName "AAAI" .

# ── Keywords ─────────────────────────────────────────────────────────────────
akp:kw_transformer rdf:type akp:Keyword ; rdfs:label "Transformer" .
akp:kw_attention   rdf:type akp:Keyword ; rdfs:label "Attention Mechanism" .
akp:kw_bert        rdf:type akp:Keyword ; rdfs:label "BERT" .
akp:kw_gnn         rdf:type akp:Keyword ; rdfs:label "Graph Neural Networks" .
akp:kw_rl          rdf:type akp:Keyword ; rdfs:label "Reinforcement Learning" .
akp:kw_llm         rdf:type akp:Keyword ; rdfs:label "Large Language Models" .
akp:kw_ontology    rdf:type akp:Keyword ; rdfs:label "Ontology" .
akp:kw_sparql      rdf:type akp:Keyword ; rdfs:label "SPARQL" .
akp:kw_gru         rdf:type akp:Keyword ; rdfs:label "GRU-RNN" .         # [v2] new
akp:kw_seq2seq     rdf:type akp:Keyword ; rdfs:label "Seq2Seq" .         # [v2] new

# ── Authors ──────────────────────────────────────────────────────────────────
akp:author_vaswani rdf:type akp:Author ;
    akp:name "Ashish Vaswani" ;
    akp:orcid "0000-0001-9987-0001" ;
    akp:hIndex 25 ;
    akp:affiliatedWith akp:inst_mit .

akp:author_devlin rdf:type akp:Author ;
    akp:name "Jacob Devlin" ;
    akp:orcid "0000-0001-9987-0002" ;
    akp:hIndex 20 ;
    akp:affiliatedWith akp:inst_stanford .

akp:author_lecun rdf:type akp:Author ;
    akp:name "Yann LeCun" ;
    akp:orcid "0000-0001-9987-0003" ;
    akp:hIndex 90 ;
    akp:affiliatedWith akp:inst_stanford .

akp:author_bengio rdf:type akp:Author ;
    akp:name "Yoshua Bengio" ;
    akp:orcid "0000-0001-9987-0004" ;
    akp:hIndex 112 ;
    akp:affiliatedWith akp:inst_cambridge .

akp:author_hinton rdf:type akp:Author ;
    akp:name "Geoffrey Hinton" ;
    akp:orcid "0000-0001-9987-0005" ;
    akp:hIndex 138 ;
    akp:affiliatedWith akp:inst_cambridge .

akp:author_kipf rdf:type akp:Author ;
    akp:name "Thomas Kipf" ;
    akp:orcid "0000-0001-9987-0006" ;
    akp:hIndex 18 ;
    akp:affiliatedWith akp:inst_mit .

akp:author_mikolov rdf:type akp:Author ;
    akp:name "Tomas Mikolov" ;
    akp:orcid "0000-0001-9987-0007" ;
