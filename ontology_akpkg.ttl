@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix akp: <http://www.akpkg.org/ontology#> .

# ─── Ontology Declaration ───────────────────────────────────────────────────
<http://www.akpkg.org/ontology>
    rdf:type owl:Ontology ;
    rdfs:label "Academic Publication Knowledge Graph Ontology" ;
    rdfs:comment "An ontology for modeling academic publications, authors, citations, and institutions." ;
    owl:versionInfo "1.0" .

# ─── Classes (TBox) ─────────────────────────────────────────────────────────
akp:Publication rdf:type owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "An academic publication." .

akp:Paper rdf:type owl:Class ;
    rdfs:subClassOf akp:Publication ;
    rdfs:label "Paper" .

akp:JournalArticle rdf:type owl:Class ;
    rdfs:subClassOf akp:Paper ;
    rdfs:label "Journal Article" .

akp:ConferencePaper rdf:type owl:Class ;
    rdfs:subClassOf akp:Paper ;
    rdfs:label "Conference Paper" .

akp:Author rdf:type owl:Class ;
    rdfs:label "Author" .

akp:Institution rdf:type owl:Class ;
    rdfs:label "Institution" .

akp:Venue rdf:type owl:Class ;
    rdfs:label "Venue" .

akp:Journal rdf:type owl:Class ;
    rdfs:subClassOf akp:Venue ;
    rdfs:label "Journal" .

akp:Conference rdf:type owl:Class ;
    rdfs:subClassOf akp:Venue ;
    rdfs:label "Conference" .

akp:ResearchField rdf:type owl:Class ;
    rdfs:label "Research Field" .

akp:Keyword rdf:type owl:Class ;
    rdfs:label "Keyword" .

# ─── Object Properties ──────────────────────────────────────────────────────
akp:hasAuthor rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range akp:Author ;
    rdfs:label "has author" .

akp:affiliatedWith rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Author ;
    rdfs:range akp:Institution ;
    rdfs:label "affiliated with" .

akp:publishedIn rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range akp:Venue ;
    rdfs:label "published in" .

akp:cites rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range akp:Publication ;
    rdfs:label "cites" .

akp:hasKeyword rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range akp:Keyword ;
    rdfs:label "has keyword" .

akp:belongsToField rdf:type owl:ObjectProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range akp:ResearchField ;
    rdfs:label "belongs to field" .

akp:collaboratesWith rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain akp:Author ;
    rdfs:range akp:Author ;
    rdfs:label "collaborates with" .

# ─── Data Properties ────────────────────────────────────────────────────────
akp:title rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range xsd:string .

akp:year rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range xsd:integer .

akp:doi rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range xsd:string .

akp:abstract rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range xsd:string .

akp:citationCount rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Publication ;
    rdfs:range xsd:integer .

akp:name rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Author ;
    rdfs:range xsd:string .

akp:orcid rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Author ;
    rdfs:range xsd:string .

akp:hIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Author ;
    rdfs:range xsd:integer .

akp:institutionName rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Institution ;
    rdfs:range xsd:string .

akp:country rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Institution ;
    rdfs:range xsd:string .

akp:venueName rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Venue ;
    rdfs:range xsd:string .

akp:impactFactor rdf:type owl:DatatypeProperty ;
    rdfs:domain akp:Journal ;
    rdfs:range xsd:decimal .

# ─── Instances (ABox) ───────────────────────────────────────────────────────
# Institutions
akp:inst_mit rdf:type akp:Institution ;
    akp:institutionName "Massachusetts Institute of Technology" ;
    akp:country "USA" .

akp:inst_stanford rdf:type akp:Institution ;
    akp:institutionName "Stanford University" ;
    akp:country "USA" .

akp:inst_cambridge rdf:type akp:Institution ;
    akp:institutionName "University of Cambridge" ;
    akp:country "UK" .

akp:inst_metu rdf:type akp:Institution ;
    akp:institutionName "Middle East Technical University" ;
    akp:country "Turkey" .

# Research Fields
akp:field_ml rdf:type akp:ResearchField ;
    rdfs:label "Machine Learning" .

akp:field_nlp rdf:type akp:ResearchField ;
    rdfs:label "Natural Language Processing" .

akp:field_kg rdf:type akp:ResearchField ;
    rdfs:label "Knowledge Graphs" .

akp:field_cv rdf:type akp:ResearchField ;
    rdfs:label "Computer Vision" .

# Journals
akp:journal_nature rdf:type akp:Journal ;
    akp:venueName "Nature" ;
    akp:impactFactor 49.962 .

akp:journal_science rdf:type akp:Journal ;
    akp:venueName "Science" ;
    akp:impactFactor 47.728 .

akp:journal_jair rdf:type akp:Journal ;
    akp:venueName "Journal of Artificial Intelligence Research" ;
    akp:impactFactor 4.676 .

# Conferences
akp:conf_neurips rdf:type akp:Conference ;
    akp:venueName "NeurIPS" .

akp:conf_iclr rdf:type akp:Conference ;
    akp:venueName "ICLR" .

akp:conf_acl rdf:type akp:Conference ;
    akp:venueName "ACL" .

akp:conf_aaai rdf:type akp:Conference ;
    akp:venueName "AAAI" .

# Keywords
akp:kw_transformer rdf:type akp:Keyword ; rdfs:label "Transformer" .
akp:kw_attention rdf:type akp:Keyword ; rdfs:label "Attention Mechanism" .
akp:kw_bert rdf:type akp:Keyword ; rdfs:label "BERT" .
akp:kw_gnn rdf:type akp:Keyword ; rdfs:label "Graph Neural Networks" .
akp:kw_rl rdf:type akp:Keyword ; rdfs:label "Reinforcement Learning" .
akp:kw_llm rdf:type akp:Keyword ; rdfs:label "Large Language Models" .
akp:kw_ontology rdf:type akp:Keyword ; rdfs:label "Ontology" .
akp:kw_sparql rdf:type akp:Keyword ; rdfs:label "SPARQL" .

# Authors
akp:author_vaswani rdf:type akp:Author ;
    akp:name "Ashish Vaswani" ;
    akp:orcid "0000-0001-9987-0001" ;
    akp:hIndex 25 ;
    akp:affiliatedWith akp:inst_mit .

akp:author_devlin rdf:type akp:Author ;
    akp:name "Jacob Devlin" ;
    akp:orcid "0000-0001-9987-0002" ;
    akp:hIndex 20 ;
    akp:affiliatedWith akp:inst_stanford .

akp:author_lecun rdf:type akp:Author ;
    akp:name "Yann LeCun" ;
    akp:orcid "0000-0001-9987-0003" ;
    akp:hIndex 90 ;
    akp:affiliatedWith akp:inst_stanford .

akp:author_bengio rdf:type akp:Author ;
    akp:name "Yoshua Bengio" ;
    akp:orcid "0000-0001-9987-0004" ;
    akp:hIndex 112 ;
    akp:affiliatedWith akp:inst_cambridge .

akp:author_hinton rdf:type akp:Author ;
    akp:name "Geoffrey Hinton" ;
    akp:orcid "0000-0001-9987-0005" ;
    akp:hIndex 138 ;
    akp:affiliatedWith akp:inst_cambridge .

akp:author_kipf rdf:type akp:Author ;
    akp:name "Thomas Kipf" ;
    akp:orcid "0000-0001-9987-0006" ;
    akp:hIndex 18 ;
    akp:affiliatedWith akp:inst_mit .

akp:author_mikolov rdf:type akp:Author ;
    akp:name "Tomas Mikolov" ;
    akp:orcid "0000-0001-9987-0007" ;
    akp:hIndex 30 ;
    akp:affiliatedWith akp:inst_stanford .

akp:author_goodfellow rdf:type akp:Author ;
    akp:name "Ian Goodfellow" ;
    akp:orcid "0000-0001-9987-0008" ;
    akp:hIndex 55 ;
    akp:affiliatedWith akp:inst_stanford .

# Collaborations
akp:author_vaswani akp:collaboratesWith akp:author_devlin .
akp:author_lecun akp:collaboratesWith akp:author_bengio .
akp:author_bengio akp:collaboratesWith akp:author_hinton .
akp:author_goodfellow akp:collaboratesWith akp:author_bengio .

# Publications (ABox)
akp:paper_attention rdf:type akp:ConferencePaper ;
    akp:title "Attention Is All You Need" ;
    akp:year 2017 ;
    akp:doi "10.48550/arXiv.1706.03762" ;
    akp:abstract "We propose a new simple network architecture, the Transformer, based solely on attention mechanisms." ;
    akp:citationCount 90000 ;
    akp:hasAuthor akp:author_vaswani ;
    akp:publishedIn akp:conf_neurips ;
    akp:hasKeyword akp:kw_transformer ;
    akp:hasKeyword akp:kw_attention ;
    akp:belongsToField akp:field_nlp .

akp:paper_bert rdf:type akp:ConferencePaper ;
    akp:title "BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding" ;
    akp:year 2019 ;
    akp:doi "10.48550/arXiv.1810.04805" ;
    akp:abstract "We introduce BERT, a new language representation model." ;
    akp:citationCount 55000 ;
    akp:hasAuthor akp:author_devlin ;
    akp:publishedIn akp:conf_acl ;
    akp:hasKeyword akp:kw_bert ;
    akp:hasKeyword akp:kw_transformer ;
    akp:belongsToField akp:field_nlp ;
    akp:cites akp:paper_attention .

akp:paper_gcn rdf:type akp:ConferencePaper ;
    akp:title "Semi-Supervised Classification with Graph Convolutional Networks" ;
    akp:year 2017 ;
    akp:doi "10.48550/arXiv.1609.02907" ;
    akp:abstract "We present a scalable approach for semi-supervised classification using GCNs." ;
    akp:citationCount 25000 ;
    akp:hasAuthor akp:author_kipf ;
    akp:publishedIn akp:conf_iclr ;
    akp:hasKeyword akp:kw_gnn ;
    akp:belongsToField akp:field_ml .

akp:paper_word2vec rdf:type akp:ConferencePaper ;
    akp:title "Distributed Representations of Words and Phrases" ;
    akp:year 2013 ;
    akp:doi "10.48550/arXiv.1310.4546" ;
    akp:abstract "We propose several extensions of word2vec." ;
    akp:citationCount 18000 ;
    akp:hasAuthor akp:author_mikolov ;
    akp:publishedIn akp:conf_neurips ;
    akp:hasKeyword akp:kw_llm ;
    akp:belongsToField akp:field_nlp .

akp:paper_gans rdf:type akp:ConferencePaper ;
    akp:title "Generative Adversarial Networks" ;
    akp:year 2014 ;
    akp:doi "10.48550/arXiv.1406.2661" ;
    akp:abstract "We propose a new framework for estimating generative models via adversarial training." ;
    akp:citationCount 40000 ;
    akp:hasAuthor akp:author_goodfellow ;
    akp:hasAuthor akp:author_bengio ;
    akp:publishedIn akp:conf_neurips ;
    akp:hasKeyword akp:kw_rl ;
    akp:belongsToField akp:field_ml .

akp:paper_deeplearning rdf:type akp:JournalArticle ;
    akp:title "Deep Learning" ;
    akp:year 2015 ;
    akp:doi "10.1038/nature14539" ;
    akp:abstract "Deep learning allows computational models with multiple processing layers to learn representations of data." ;
    akp:citationCount 65000 ;
    akp:hasAuthor akp:author_lecun ;
    akp:hasAuthor akp:author_bengio ;
    akp:hasAuthor akp:author_hinton ;
    akp:publishedIn akp:journal_nature ;
    akp:hasKeyword akp:kw_llm ;
    akp:belongsToField akp:field_ml .

akp:paper_kg_embed rdf:type akp:JournalArticle ;
    akp:title "Knowledge Graph Embedding: A Survey of Approaches and Applications" ;
    akp:year 2017 ;
    akp:doi "10.1109/TKDE.2017.2754499" ;
    akp:abstract "This paper reviews knowledge graph embedding methods." ;
    akp:citationCount 5000 ;
    akp:hasAuthor akp:author_hinton ;
    akp:publishedIn akp:journal_jair ;
    akp:hasKeyword akp:kw_ontology ;
    akp:hasKeyword akp:kw_sparql ;
    akp:belongsToField akp:field_kg ;
    akp:cites akp:paper_gcn .

akp:paper_llm_survey rdf:type akp:JournalArticle ;
    akp:title "A Survey of Large Language Models" ;
    akp:year 2023 ;
    akp:doi "10.48550/arXiv.2303.18223" ;
    akp:abstract "This paper reviews the recent advances of LLMs." ;
    akp:citationCount 8000 ;
    akp:hasAuthor akp:author_bengio ;
    akp:publishedIn akp:journal_jair ;
    akp:hasKeyword akp:kw_llm ;
    akp:hasKeyword akp:kw_transformer ;
    akp:belongsToField akp:field_nlp ;
    akp:cites akp:paper_attention ;
    akp:cites akp:paper_bert .
